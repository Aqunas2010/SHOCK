# SHOCK: Clinical Learning & Emergency Management
# Environment Variables Example Configuration

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PostgreSQL Database Connection (e.g. Neon, Supabase, or AWS RDS)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/shock_db"

# NextAuth / Auth.js (Optional for future user account synchronization)
AUTH_SECRET="your-32-character-secret-key-placeholder"
NEXTAUTH_URL="http://localhost:3000"
