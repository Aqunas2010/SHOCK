generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lesson {
  id               String   @id @default(cuid())
  number           Int      @unique
  slug             String   @unique
  tag              String
  title            String
  subtitle         String
  description      String
  estimatedMinutes Int
  category         String
  keyTakeaways     String[]
  pearl            String?
  caution          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model QuizQuestion {
  id              String       @id @default(cuid())
  number          Int          @unique
  category        String
  question        String
  correctOptionId String
  explanation     String
  clinicalPearl   String
  options         QuizOption[]
  createdAt       DateTime     @default(now())
}

model QuizOption {
  id         String       @id @default(cuid())
  optionKey  String
  text       String
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id         String   @id @default(cuid())
  userId     String?
  score      Int
  total      Int
  percentage Int
  passed     Boolean
  answers    Json
  createdAt  DateTime @default(now())
}

model UserProgress {
  id               String   @id @default(cuid())
  userId           String   @unique
  completedLessons String[]
  bookmarkedLessons String[]
  lastVisitedSlug  String   @default("understanding-shock")
  quizHighScore    Int?
  updatedAt        DateTime @updatedAt
}
